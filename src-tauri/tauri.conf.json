{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pergament",
  "version": "1.9.0",
  "identifier": "io.github.v3rm1n.pergament",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pergament",
        "width": 1320,
        "height": 860,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": [] },
      "csp": "default-src 'self'; img-src 'self' blob: jwmedia: http://jwmedia.localhost data: https://*.jw-cdn.org; media-src https://*.jw-cdn.org asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/256x256.png", "icons/128x128.png", "icons/64x64.png", "icons/32x32.png"],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libsoup-3.0-0", "libssl3", "libsqlite3-0", "gstreamer1.0-libav"],
        "desktopTemplate": "desktop.template",
        "files": {
          "/usr/share/metainfo/io.github.v3rm1n.pergament.metainfo.xml": "io.github.v3rm1n.pergament.metainfo.xml",
          "/etc/apt/sources.list.d/pergament.sources": "../packaging/apt/pergament.sources",
          "/etc/apt/keyrings/pergament.gpg": "../packaging/apt/pergament.gpg"
        }
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "libsoup3", "openssl-libs", "sqlite-libs"],
        "recommends": ["gstreamer1-libav"],
        "desktopTemplate": "desktop.template",
        "files": { "/usr/share/metainfo/io.github.v3rm1n.pergament.metainfo.xml": "io.github.v3rm1n.pergament.metainfo.xml" }
      },
      "appimage": { "bundleMediaFramework": true }
    }
  }
}
