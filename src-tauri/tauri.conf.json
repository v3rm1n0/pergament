{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pergament",
  "version": "1.1.0",
  "identifier": "io.github.v3rm1n.pergament",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pergament",
        "width": 1320,
        "height": 860,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: jwmedia: http://jwmedia.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/256x256.png", "icons/128x128.png", "icons/64x64.png", "icons/32x32.png"]
  }
}
